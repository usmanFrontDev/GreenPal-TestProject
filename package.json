{
  "name": "app",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --minify --outdir=app/assets/builds --loader:.js=jsx --loader:.jsx=jsx",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --minify",
    "watch": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --loader:.js=jsx --loader:.jsx=jsx --watch",
    "watch:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --watch"
  },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "3.4.14",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "lucide-react": "^0.263.1"
  }
}