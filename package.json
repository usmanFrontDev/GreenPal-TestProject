{
  "name": "app",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "esbuild-plugin-postcss2": "^0.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.14"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --loader:.js=jsx --loader:.jsx=jsx",
    "watch": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --loader:.js=jsx --loader:.jsx=jsx --watch"
   },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
