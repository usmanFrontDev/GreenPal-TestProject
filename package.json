{
  "scripts": {
    "build": "esbuild app/javascript/application.jsx --bundle --sourcemap --outdir=app/assets/builds --loader:.js=jsx --loader:.jsx=jsx",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tailwindcss": "3.4.14"
  }
}