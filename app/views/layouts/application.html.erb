<!DOCTYPE html>
<html>
  <head>
    <title>Landing Page</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- React aur ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <!-- Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  </head>

  <body class="m-0 p-0">
    <%= yield %>
    
    <script type="text/babel">
      const { useState } = React;

      function LandingPage() {
        const [email, setEmail] = useState('');

        const handleSubmit = (e) => {
          e.preventDefault();
          alert('Thanks for signing up! Email: ' + email);
          setEmail('');
        };

        return (
          <div className="min-h-screen bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500">
            {/* Navbar */}
            <nav className="bg-white/10 backdrop-blur-md border-b border-white/20">
              <div className="container mx-auto px-6 py-4 flex justify-between items-center">
                <div className="text-white text-2xl font-bold">
                  🚀 MyStartup
                </div>
                <div className="space-x-4">
                  <button className="text-white hover:text-gray-200 transition">
                    Features
                  </button>
                  <button className="text-white hover:text-gray-200 transition">
                    Pricing
                  </button>
                  <button className="bg-white text-purple-600 px-6 py-2 rounded-full font-semibold hover:bg-gray-100 transition">
                    Sign In
                  </button>
                </div>
              </div>
            </nav>

            {/* Hero Section */}
            <div className="container mx-auto px-6 py-20 text-center">
              <h1 className="text-6xl font-extrabold text-white mb-6 leading-tight">
                Build Your Dream<br />
                <span className="text-yellow-300">Landing Page</span>
              </h1>
              
              <p className="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
                Create stunning landing pages with React, Ruby on Rails, and Tailwind CSS. 
                Fast, modern, and beautiful.
              </p>

              {/* Email Form */}
              <form onSubmit={handleSubmit} className="max-w-md mx-auto mb-12">
                <div className="flex gap-2">
                  <input
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="Enter your email"
                    required
                    className="flex-1 px-6 py-4 rounded-full text-gray-800 focus:outline-none focus:ring-4 focus:ring-yellow-300"
                  />
                  <button
                    type="submit"
                    className="bg-yellow-400 text-gray-900 px-8 py-4 rounded-full font-bold hover:bg-yellow-300 transition transform hover:scale-105"
                  >
                    Get Started
                  </button>
                </div>
              </form>

              {/* Stats */}
              <div className="grid grid-cols-3 gap-8 max-w-3xl mx-auto mt-16">
                <div className="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
                  <div className="text-4xl font-bold text-yellow-300">10K+</div>
                  <div className="text-white mt-2">Active Users</div>
                </div>
                <div className="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
                  <div className="text-4xl font-bold text-yellow-300">99%</div>
                  <div className="text-white mt-2">Satisfaction</div>
                </div>
                <div className="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
                  <div className="text-4xl font-bold text-yellow-300">24/7</div>
                  <div className="text-white mt-2">Support</div>
                </div>
              </div>
            </div>

            {/* Features Section */}
            <div className="bg-white py-20">
              <div className="container mx-auto px-6">
                <h2 className="text-4xl font-bold text-center text-gray-800 mb-12">
                  Amazing Features
                </h2>
                <div className="grid md:grid-cols-3 gap-8">
                  <div className="text-center">
                    <div className="text-5xl mb-4">⚡</div>
                    <h3 className="text-xl font-bold mb-2">Lightning Fast</h3>
                    <p className="text-gray-600">Build and deploy in minutes</p>
                  </div>
                  <div className="text-center">
                    <div className="text-5xl mb-4">🎨</div>
                    <h3 className="text-xl font-bold mb-2">Beautiful Design</h3>
                    <p className="text-gray-600">Tailwind CSS powered styling</p>
                  </div>
                  <div className="text-center">
                    <div className="text-5xl mb-4">🔒</div>
                    <h3 className="text-xl font-bold mb-2">Secure</h3>
                    <p className="text-gray-600">Rails backend security</p>
                  </div>
                </div>
              </div>
            </div>

            {/* Footer */}
            <footer className="bg-gray-900 text-white py-8">
              <div className="container mx-auto px-6 text-center">
                <p>© 2024 MyStartup. Made with ❤️ using React, Rails & Tailwind</p>
              </div>
            </footer>
          </div>
        );
      }

      const root = ReactDOM.createRoot(document.getElementById('root'));
      root.render(<LandingPage />);
    </script>
  </body>
</html>